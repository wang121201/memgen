+  (folder/'stdout').write_text(proc.stdout);(folder/'stderr').write_text(proc.stderr)
+  if rejection:
+   assert proc.returncode!=0 and rejection in proc.stderr,(name,proc.returncode,proc.stderr)
+  else:
+   assert proc.returncode==0,proc.stderr
+   stats=json.loads((folder/'source.json').read_text())
