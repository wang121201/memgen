@@ -0,0 +1,50 @@
+"""CPU-only differential fitting of retained, replay-qualified native samples."""
+import argparse,gzip,hashlib,json,pathlib,sys,time,types
+P=pathlib.Path
+U=P('/home/xmu/nvidiagds/codex-runs/l2-sglang-full-qualified-20260919-01a08d87-r1')
+sys.path.insert(0,str(U))
+import sglang_sample_to_packed as p
+from sparse_rule_extensions import install
+from sparse_profile_adapter import install as install_structure
+
+def main():
+    args=argparse.ArgumentParser();args.add_argument('--receipt',type=P,required=True);args.add_argument('--output',type=P,required=True);a=args.parse_args()
+    receipt=json.loads(a.receipt.read_text())
+    assert receipt['replay_closed'] and receipt['transport_qualified']
+    a.output.mkdir();p.frozen_gate();baseline=p.rules.fit_x_quotient_remainder_y_table_z_partition;baseline_fit=p.fit;baseline_selector=p.template_by_cta
+    rows=[]
+    for item in receipt['native_fixtures']:
+        raw=P(item['path']).read_bytes();assert hashlib.sha256(raw).hexdigest()==item['sha256']
+        fixture=json.loads(gzip.decompress(raw));info=fixture['collector']
+        collector=types.SimpleNamespace(**{k:v for k,v in info.items() if k!='samples'})
+        collector.samples={(row['cta'],row['warp']):row['frames'] for row in info['samples']}
+        assert collector.count==sum(len(v) for v in collector.samples.values())
+        row=dict(source_launch_key=item['source_launch_key'],code_sha256=fixture['begin']['code_sha256'],grid=fixture['begin']['grid'],records=collector.count)
+        profiles={}
+        for variant in ['baseline','extended']:
+            p.rules.fit_x_quotient_remainder_y_table_z_partition=baseline
+            p.fit=baseline_fit;p.template_by_cta=baseline_selector
+            if variant=='extended':install(p.rules);install_structure(p)
+            started=time.perf_counter()
+            try:
+                profile=p.fit(collector,fixture['begin'],fixture['end'],fixture['transport'])
+                profiles[variant]=profile
+                row[variant]=dict(status='PASS_EXACT_SAMPLES',census=profile['independent_source_census'],sampling=profile['sampling'])
+                if variant=='extended':
+                    target=a.output/(item['source_launch_key']+'.profile.json')
+                    with target.open('xb') as f:f.write(p.rules.canonical_json(profile))
+            except (AssertionError,ValueError) as e:row[variant]=dict(status='REJECTED',reason=str(e))
+            row[variant]['seconds']=time.perf_counter()-started
+        if 'baseline' in profiles:
+            assert 'extended' in profiles,'regression of accepted native profile'
+            candidate=json.loads(p.rules.canonical_json(profiles['extended']))
+            candidate['sampling'].pop('runtime_completion_owner',None)
+            assert p.rules.canonical_json(profiles['baseline'])==p.rules.canonical_json(candidate),'baseline source changed'
+        rows.append(row)
+    result=dict(status='PASS_CPU_FIXTURE_DIFFERENTIAL_NOT_LLM_ACCURACY',source_receipt=str(a.receipt),source_receipt_sha256=hashlib.sha256(a.receipt.read_bytes()).hexdigest(),rows=rows,
+                recovered=sum(x['baseline']['status']=='REJECTED' and x['extended']['status']=='PASS_EXACT_SAMPLES' for x in rows),
+                unchanged_accepted=sum(x['baseline']['status']=='PASS_EXACT_SAMPLES' for x in rows))
+    with (a.output/'result.json').open('x') as f:json.dump(result,f,indent=2)
+    print(json.dumps({k:v for k,v in result.items() if k!='rows'}))
+
+if __name__=='__main__':main()
