@@ -0,0 +1,194 @@
+"""Private sparse structures and exact census; unchanged source qualification.
+
+Schema 12 adds disjoint, covering linear-CTA intervals. Its current fitter only
+admits observed endpoint exceptions or an active prefix whose boundary is
+uniquely pinned by adjacent training CTAs. Independent interior class holdouts
+remain mandatory; complete exception domains do not claim holdout validation.
+"""
+import collections,math,time
+import sglang_sample_to_packed as upstream
+from profile_census import count_profile
+from sglang_sample_to_packed import (rules,projection_record_census,normalize,
+ validate_samples,direction_width,lane_offsets,global_opcode,captured_digest)
+UPSTREAM_SHA256='ffdede8a8c179d8bf3282a5ed5b33f05eb8186426199973b8ae6156b945afe95'
+_original_template_by_cta=upstream.template_by_cta
+COMPLETION_OWNER_CODE='b90813cd121a844dab28477a46e33d6fc028bcef666341c6e56aadb1437b91c8'
+
+def template_by_cta(profile):
+ if profile['schema']['version']!=12:return _original_template_by_cta(profile)
+ selector=profile['structural_class_selector'];assert selector['kind']=='linear_cta_intervals'
+ classes={x['class_id']:x for x in profile['structural_classes']}
+ assert len(classes)==len(profile['structural_classes']) and all(classes)
+ n=profile['kernel']['grid_size'];mapping=[];used=set()
+ for item in selector['intervals']:
+  lo,hi,cid=item['start'],item['stop'],item['class_id']
+  assert type(lo) is int and type(hi) is int and lo==len(mapping) and lo<hi<=n
+  assert cid in classes
+  mapping.extend([cid]*(hi-lo));used.add(cid)
+ assert len(mapping)==n and used==set(classes)
+ declared_train=profile['sampling']['training_ctas'];declared_hold=profile['sampling']['holdout_ctas']
+ assert len(set(declared_train))==len(declared_train) and len(set(declared_hold))==len(declared_hold) and set(declared_train).isdisjoint(declared_hold)
+ if 'source' in profile:
+  assert set(profile['source']['launch']['fit_ctas'])==set(declared_train) and set(profile['source']['launch']['holdout_ctas'])==set(declared_hold)
+ observed_train=set();observed_hold=set()
+ for cid,klass in classes.items():
+  training=klass['ctas'];held=klass['independent_holdout_ctas']
+  assert training and len(set(training))==len(training) and all(type(c) is int and 0<=c<n and mapping[c]==cid for c in training)
+  assert len(set(held))==len(held) and set(held).isdisjoint(training) and all(type(c) is int and 0<=c<n and mapping[c]==cid for c in held)
+  assert set(training)<=set(declared_train) and set(held)<=set(declared_hold)
+  observed_train.update(training);observed_hold.update(held)
+  domain={c for c,x in enumerate(mapping) if x==cid}
+  assert klass['domain_cta_count']==len(domain)
+  if klass['observed_domain_complete']:assert set(training)==domain and not held
+  else:assert len(training)>=2 and len(held)>=2
+ assert observed_train==set(declared_train) and observed_hold==set(declared_hold)
+ return [classes[cid]['template'] for cid in mapping]
+
+def build_linear_structure(profile,sampled,indexed,train,hold,grid):
+ profile['sampling']=dict(training_ctas=train,holdout_ctas=hold)
+ n=math.prod(grid);assert {0,1,n-2,n-1}<=set(train),'linear structure needs training at both boundaries and their neighbors'
+ structure={c:frozenset(slots) for c,(_,slots) in indexed.items()}
+ interior={structure[c] for c in train if 0<c<n-1}
+ if len(interior)==1:
+  middle=next(iter(interior));parts=[(0,1,structure[0]),(1,n-1,middle),(n-1,n,structure[n-1])]
+  family='observed_endpoint_exceptions'
+ else:
+  active=[c for c in train if structure[c]];empty=[c for c in train if not structure[c]]
+  assert active and empty and min(active)==0 and max(empty)==n-1,'unsupported linear structural family'
+  kinds={structure[c] for c in active};assert len(kinds)==1,'active prefix has heterogeneous structure'
+  cut=max(active)+1
+  assert cut==min(empty),'active prefix boundary is not uniquely identified by adjacent training CTAs'
+  parts=[(0,cut,next(iter(kinds))),(cut,n,frozenset())];family='adjacent_training_identified_active_prefix'
+ merged=[]
+ for lo,hi,key in parts:
+  if merged and merged[-1][2]==key:merged[-1]=(merged[-1][0],hi,key)
+  else:merged.append((lo,hi,key))
+ mapping=[key for lo,hi,key in merged for _ in range(lo,hi)]
+ assert len(mapping)==n and all(mapping[c]==structure[c] for c in train),'training structural selector mismatch'
+ # Training selects the family and boundary before holdout inspection.
+ assert all(mapping[c]==structure[c] for c in hold),'heldout linear structure differs'
+ keys=list(dict.fromkeys(mapping));ids={key:'class-%02d'%i for i,key in enumerate(keys)};classes=[]
+ for key in keys:
+  domain={c for c,k in enumerate(mapping) if k==key};ctas=sorted(set(train)&domain);held=sorted(set(hold)&domain)
+  complete=set(ctas)==domain
+  if not complete:assert len(ctas)>=2 and len(held)>=2,'extrapolated structural class lacks independent witnesses'
+  try:template=rules.build_template(sampled,indexed,ctas,grid,coordinate_rules=True,allow_exact_table=complete)
+  except ValueError:
+   assert not complete
+   template=rules.build_template(sampled,indexed,ctas,grid,coordinate_rules=False,allow_exact_table=False)
+  if complete:
+   for entry in template:
+    for rule in entry['address_rules']:
+     if rule.get('kind')=='exact_cta_base_table':rule['scope']='complete_observed_structural_class_domain'
+  classes.append(dict(class_id=ids[key],ctas=ctas,template=template,
+    cta_membership_scope='complete_observed_class_domain' if complete else 'training_samples_only',
+    domain_cta_count=len(domain),observed_domain_complete=complete,independent_holdout_ctas=[] if complete else held))
