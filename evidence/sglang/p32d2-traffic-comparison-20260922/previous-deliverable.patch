+They permit CPU iteration without collecting a complete model memory trace.
+"""
+from pathlib import Path
+import argparse,gzip,hashlib,json,os,stat,sys,time,traceback
+UPSTREAM=Path('/home/xmu/nvidiagds/codex-runs/l2-sglang-full-qualified-20260919-01a08d87-r1')
+assert hashlib.sha256((UPSTREAM/'full_source_postprocess.py').read_bytes()).hexdigest() == '58514bec7ed932d943bcca8d0dbbca9d4eb2926a2379ba8d6a66428321a3f31b'
+sys.path.insert(0,str(UPSTREAM))
+import sglang_sample_to_packed as p
+from sparse_rule_extensions import install
+install(p.rules)
+from sparse_profile_adapter import install as install_structure,UPSTREAM_SHA256
+assert hashlib.sha256((UPSTREAM/'sglang_sample_to_packed.py').read_bytes()).hexdigest()==UPSTREAM_SHA256
+install_structure(p)
+
+def main():
+ a=argparse.ArgumentParser();a.add_argument('--output',type=Path,required=True);a.add_argument('--transport-receipt',type=Path,required=True);a=a.parse_args()
+ a.output.mkdir(parents=True);p.frozen_gate();rows=[];offset=0;profile_bytes=0;fixture_bytes=0;fixture_json_bytes=0;fixtures=[]
+ fixture_dir=a.output/'native-fixtures';fixture_dir.mkdir()
+ contract=p.HERE/'target-contract.json'
+ source_scope='representative_subset' # This executable is only a diagnostic pilot.
+ assert source_scope in ['all_native_launches','representative_subset']
+ pack=a.output/'profiles.pack';index=a.output/'profiles.index.jsonl'
+ # Every row retains an actual launch identity. No copy from another layer,
+ # zero filling rejected launches, or source-count-based traffic injection.
+ def decoded(collector,begin,end,transport):
+  nonlocal offset,profile_bytes,fixture_bytes,fixture_json_bytes
+  started=time.monotonic();key=begin['source_launch_key']
+  row=dict(source_launch_key=key,phase=begin['phase'],role=begin.get('role'),layer_id=begin['layer_id'],code_sha256=begin['code_sha256'],kernel_name=begin['kernel_name'],status='REJECTED',hardware_accuracy_accepted=False)
+  # Retain the four previously rejected code families plus three controls.
+  # These are the already selected sparse CTAs, never extra full-grid capture.
+  retain=begin['code_sha256'].startswith(('62ee9483','d7d73af0','ee37b075','b90813cd')) or len(rows)<3
+  if retain:
+   payload=dict(schema='HBSERVE_NATIVE_SPARSE_FIXTURE_V1',scope='development_samples_requires_parent_replay_closure',begin=begin,end=end,
+     transport=dict(status=transport['status'],kernels=[x for x in transport['kernels'] if x['source_launch_key']==key]),
+     collector=dict(count=collector.count,estimated_sites=list(collector.estimated_sites),shared_only_census=dict(getattr(collector,'shared_only_census',{})),async_source_census=dict(getattr(collector,'async_source_census',{})),
+       samples=[dict(cta=c,warp=w,frames=frames) for (c,w),frames in sorted(collector.samples.items())]))
+   path=fixture_dir/(key+'.json.gz');json_bytes=0
+   with path.open('xb') as raw, gzip.GzipFile(fileobj=raw,mode='wb',mtime=0) as f:
+    for chunk in json.JSONEncoder(separators=(',',':')).iterencode(payload):
+     data=chunk.encode();json_bytes+=len(data)
+     assert json_bytes<=128<<20 and fixture_json_bytes+json_bytes<=512<<20,'native fixture retention budget exceeded'
+     f.write(data)
+   n=path.stat().st_size;fixture_bytes+=n;fixture_json_bytes+=json_bytes
+   item=dict(path=str(path),sha256=hashlib.sha256(path.read_bytes()).hexdigest(),compressed_bytes=n,json_bytes=json_bytes,records=collector.count,source_launch_key=key)
+   fixtures.append(item);row['native_fixture']=item
+  try:
+   timings={};v=p.fit(collector,begin,end,transport,timings=timings)
+   if retain:
+    v['source'].update(raw_trace_saved=True,raw_trace_scope='selected_decoded_native_CTA_projection_only',native_fixture=item)
+    v['projection_record_census']['raw_records_saved']=True
+   kid=next(i for i,x in enumerate(transport['kernels'],1) if x['source_launch_key']==key)
+   v['kernel']['id']=kid
+   if 'native_reference_digest' in v:v['original_isolated_reference_digest']=v.pop('native_reference_digest')
+   v['model'].update(cache_entry='REPRESENTATIVE_SOURCE_ONLY_NO_PREFIX_REPLAY',complete_model=False)
+   raw=p.rules.canonical_json(v);assert profile_bytes+len(raw)<=8<<30,'bounded packed profile bytes'
+   with pack.open('ab') as f:f.write(raw)
+   r=dict(kernel_id=kid,source_launch_key=key,path=str(pack),offset=offset,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),status=v['status'])
+   with index.open('a') as f:f.write(json.dumps(r)+'\n')
+   offset+=len(raw);profile_bytes+=len(raw)
+   row.update(status='PROVISIONAL_PROFILE_EXACT_SAMPLES',profile_index=r,census=v['independent_source_census'],sampling=v['sampling'],stage_timings=timings)
+  except Exception as e:row.update(error=traceback.format_exc(),rejection_reason=type(e).__name__+': '+str(e))
+  row['seconds']=time.monotonic()-started;rows.append(row)
+  print(json.dumps(dict(progress=len(rows),key=key,status=row['status'],seconds=row['seconds'],reason=row.get('rejection_reason'))),flush=True)
+ result={}
+ try:
+  assert stat.S_ISFIFO(os.fstat(0).st_mode)
+  from postprocess_samples import analyze
+  result=analyze(sys.stdin.buffer,a.transport_receipt,max_records=16000000,max_encoded_bytes=512<<20,max_kernel_records=1000000,max_decoded_bytes=24<<30,model_policy='certified_entry_ldg_source_predicate',on_decoded_capture=decoded,compile_native_templates=False)
+  assert result['replay_closed'] and result['transport_qualified']
+  from entry_source_qualification import certificate
+  before=certificate()
+  certificate.cache_clear()
+  assert certificate()==before, 'entry semantic evidence changed during replay'
+  for row in rows:
+   if row['status'].startswith('PROVISIONAL_'):row.update(status='PASS_PROFILE_EXACT_SAMPLES',replay_admitted=True)
+  allkeys=[x['source_launch_key'] for x in result['kernels']];mapped={x['source_launch_key'] for x in rows}
+  # Rejection before decoding is still a missing source launch, never zero.
+  for r in result['kernels']:
+   if r['source_launch_key'] not in mapped:rows.append(dict(source_launch_key=r['source_launch_key'],status='REJECTED_BEFORE_PACKING',reason=r['candidate_rejections'],phase=r['phase'],layer_id=r['layer_id'],kernel_name=r['kernel_name']))
+  accepted=sum(r['status']=='PASS_PROFILE_EXACT_SAMPLES' for r in rows)
+  assert len(rows)==len(allkeys) and {r['source_launch_key'] for r in rows}==set(allkeys)
+  result.update(packed_profiles=rows,packed_models_accepted=accepted,profile_bytes=profile_bytes,
+     packed_models_missing=len(allkeys)-accepted,
+     source_population_scope=source_scope,selected_launch_population_complete=accepted==len(allkeys),
+     full_launch_population_complete=accepted==len(allkeys) and source_scope=='all_native_launches',complete_inference_model_comparison=False,
+     full_source_hardware_qualification=False,raw_memory_trace_bytes=fixture_bytes,native_fixture_json_bytes=fixture_json_bytes,native_fixtures=fixtures,
+     fitter_extension='unique_1d_quotient_remainder_v1_and_schema12_linear_structure_and_exact_census',native_fixture_scope='selected_samples_per_sampling_contract_not_hardware_validation')
+  code=0
+ except Exception:
+  for row in rows:
+   if row['status'].startswith(('PROVISIONAL_','PASS_')):row.update(status='REJECTED_GLOBAL_REPLAY_CLOSURE',replay_admitted=False)
+  result=dict(status='FAIL',error=traceback.format_exc(),packed_models_accepted=0,packed_models_missing=None,coverage_status='UNDETERMINED_REPLAY_NOT_CLOSED',full_launch_population_complete=False,packed_profiles=rows,complete_inference_model_comparison=False);code=1
+ raw=(json.dumps(result,indent=2)+'\n').encode();assert len(raw)<=128<<20,'full source receipt cap'
+ with (a.output/'receipt.json').open('xb') as f:f.write(raw)
+ return code
+
+if __name__=='__main__':raise SystemExit(main())
