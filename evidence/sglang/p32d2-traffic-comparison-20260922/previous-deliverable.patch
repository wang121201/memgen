+      inst=OrderedMemoryInst{};inst.opcode=cg?"LDG.E.STRONG.GPU":"LDG.E.STRONG.SM";
+      inst.mask=1;inst.timestamp=++seq;inst.sequence=seq;inst.pc=16;
+      inst.sm_id=invalid_sm?48:0;inst.addr={0x123456780000ULL+offset};return true;
