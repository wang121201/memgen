+ original=R/'memgen-llm-source-p128d2d4-20260922-r3'/case/'candidate-plan.json'
+ plan=json.loads(previous.read_text());old=json.loads(original.read_text());assert len(plan['launches'])==len(old['launches'])
+ audit=[];controls=0
+ for row,initial in zip(plan['launches'],old['launches']):
+  if not row['fit_ctas'] and not row['holdout_ctas']:continue
+  code=row['code_sha256'][:8];n=row['grid'][0]*row['grid'][1]*row['grid'][2]
+  target=code in ['62ee9483','d7d73af0','ee37b075','b90813cd']
