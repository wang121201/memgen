@@ -0,0 +1,137 @@
+"""Representative address-rule pilot with the frozen full-workload driver."""
+import argparse,fcntl,hashlib,importlib.util,json,os,pathlib,signal,subprocess,time,traceback
+P=pathlib.Path;REPO=P(__file__).resolve().parents[2]
+R=P('/home/xmu/nvidiagds/codex-runs');H=R/'memgen-llm-p128-d2d4-20260922-r2';S=R/'memgen-llm-source-p128d2d4-20260922-r3'
+# Exact upstream used by the already-qualified four plans, rather than the
+# older vendored sampler (which has a smaller wire-domain contract).
+U=R/'l2-sglang-full-qualified-20260919-01a08d87-r1'
+spec=importlib.util.spec_from_file_location('hardware',H/'run_matrix.py');hw=importlib.util.module_from_spec(spec);spec.loader.exec_module(hw)
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--output',type=P,required=True,help='Fresh evidence directory; existing paths are rejected')
+parser.add_argument('--plans',type=P,required=True,help='Frozen root containing WORKLOAD/pilot.json')
+parser.add_argument('--workload',required=True,choices=[w['id'] for w in hw.read(H/'contract.json')['workloads']])
+args=parser.parse_args();OUT=args.output;PLANS=args.plans
+OUT.mkdir();result={'status':'RUNNING','source_population_scope':'representative_subset','cases':[]}
+
+def cancel(signum, frame):
+    raise InterruptedError('controller interrupted by signal '+str(signum))
+for signum in (signal.SIGTERM,signal.SIGHUP):signal.signal(signum,cancel)
+
+def stop_group(child, signum):
+    try:os.killpg(child.pid,signum)
+    except ProcessLookupError:pass
+def birth(pid):return int(P('/proc',str(pid),'stat').read_text().rsplit(')',1)[1].split()[19])
+def run_case(workload):
+    case=OUT/workload['id'];case.mkdir();plan=PLANS/workload['id']/'pilot.json'
+    assert hw.read(plan)['source_population_scope']=='representative_subset'
+    with (case/'build.stdout').open('xb') as o,(case/'build.stderr').open('xb') as e:
+        p=subprocess.run(['python3','-B',str(U/'nvbit_sampler_r4/build.py'),'--plan',str(plan),'--output',str(case/'build')],stdout=o,stderr=e,timeout=600)
+    assert p.returncode==0,'sampler build failed'
+    assert hw.read(case/'build/build.json')['status']=='PASS_BUILD_ONLY_NO_GPU'
+    env=hw.read(S/workload['id']/'command.json')['environment'];env=dict(env)
+    for k in list(env):
+        if k=='LD_PRELOAD' or k.startswith(('SG_NVBIT_','SG_SAMPLE_')):env.pop(k)
+    env['CUDA_VISIBLE_DEVICES']=hw.GPU
+    dependencies=R/'hbserve-memgen-gtsim-alignment-20260914-01a09f50-r1/sglang-integration-r10/third_party'
+    env.update(SG_HBSERVE_SOURCE_ROOT=str(dependencies/'hbserve'),SG_MEMORYINST_CODEC=str(dependencies/'hbserve_memory_template.py'))
+    cpu=dict(env,CUDA_VISIBLE_DEVICES='')
+    preflight='import sys;sys.path.insert(0,'+repr(str(U))+');import sglang_sample_to_packed as p;p.frozen_gate();from hbserve_adapter import existing_core;existing_core();from entry_source_qualification import certificate;certificate();print("PASS_CPU_SOURCE_DEPENDENCIES")'
+    with (case/'preflight.log').open('x') as f:
+        p=subprocess.run([hw.PYTHON,'-B','-c',preflight],env=cpu,stdout=f,stderr=subprocess.STDOUT,timeout=90)
+    assert p.returncode==0,'CPU source dependency preflight failed'
+    driver=S/'driver.py';model=contract['models'][workload['model']]
+    postprocessor=REPO/'research/r4_l1_filter/source_pilot_postprocess.py'
+    pins={str(p):hw.sha(p) for p in [plan,driver,case/'build/sampler.so',postprocessor,postprocessor.with_name('sparse_rule_extensions.py'),postprocessor.with_name('sparse_profile_adapter.py'),postprocessor.with_name('profile_census.py'),P(__file__)]}
+    inputs=list(U.glob('*.py'))+list(U.glob('*.json'))
+    for sub in ['nvbit_sampler_r4','template_adapter_r4']:inputs.extend((U/sub).rglob('*'))
+    for p in inputs:
+        if p.is_file() and p.suffix in ['.py','.cu','.h','.json']:pins[str(p)]=hw.sha(p)
+    hw.save(case/'source-pins.json',pins)
+    raw_read,raw_write=os.pipe();proj_read,proj_write=os.pipe();children=[];logs=[];started=time.monotonic();marked=False;lease=None;peak_rss=0;last_progress=0
+    def spawn(name,argv,cenv,stdin=subprocess.DEVNULL,stdout=None,pass_fds=()):
+        err=(case/(name+'.stderr')).open('xb');logs.append(err)
+        if stdout is None:stdout=(case/(name+'.stdout')).open('xb');logs.append(stdout)
+        c=subprocess.Popen(argv,env=cenv,stdin=stdin,stdout=stdout,stderr=err,pass_fds=pass_fds,start_new_session=True)
+        children.append(c);hw.save(case/(name+'-command.json'),{'args':argv,'pid':c.pid,'start_ticks':birth(c.pid)})
+        return c
+    try:
+        lease=(R/'llm-footprint-v1/.locks'/('gpu-'+hw.GPU+'.lock')).open('a+')
+        deadline=time.monotonic()+180
+        while True:
+            try:fcntl.flock(lease,fcntl.LOCK_EX|fcntl.LOCK_NB);break
+            except BlockingIOError:
+                assert time.monotonic()<deadline,'GPU lease wait exceeded 180 seconds'
+                (case/'lease-wait.json').write_text(json.dumps({'status':'WAITING_FOR_EXISTING_GPU_OWNER','seconds':time.monotonic()-started}))
+                time.sleep(1)
+        assert not hw.gpu_apps()
+        post=spawn('profiles',[hw.PYTHON,'-B',str(postprocessor),'--output',str(case/'profiles'),'--transport-receipt',str(case/'consumer.json')],cpu,stdin=proj_read)
+        os.close(proj_read);proj_read=None
+        consume=spawn('consumer',[hw.PYTHON,'-B',str(U/'nvbit_sampler_r4/stream_consumer.py'),'--read-fd',str(raw_read),'--max-wire-bytes',str(hw.read(plan)['max_wire_bytes']),'--plan',str(plan),'--producer-exit',str(case/'producer-exit.json'),'--receipt',str(case/'consumer.json'),'--emit-projection-records'],cpu,stdout=proj_write,pass_fds=(raw_read,))
+        os.close(raw_read);raw_read=None;os.close(proj_write);proj_write=None
+        observer=case/'observer';observer.mkdir()
+        gen=dict(env,LD_PRELOAD=str(case/'build/sampler.so'),SG_NVBIT_SCOPE_ABI='1',SG_NVBIT_OUTPUT_ROOT=str(observer),SG_NVBIT_MAX_BYTES=str(256<<20),ACK_CTX_INIT_LIMITATION='1',SG_SAMPLE_PIPE_FD=str(raw_write))
+        gpu=spawn('host',[hw.PYTHON,'-B',str(driver),'--model-path',model['path'],'--output-dir',str(case/'artifacts'),'--decode-steps',str(workload['decode_steps']),'--expected-layers',str(model['layers']),'--expected-model-class',model['class'],'--traffic-scope','none'],gen,pass_fds=(raw_write,))
+        gpu_birth=birth(gpu.pid);os.close(raw_write);raw_write=None
+        while any(c.poll() is None for c in children):
+            assert time.monotonic()-started<7200,'pilot sample/fitting time budget'
+            rss=0
+            for child in children:
+                try:
+                    fields=dict(line.split(':',1) for line in P('/proc',str(child.pid),'status').read_text().splitlines() if ':' in line)
+                    rss+=int(fields.get('VmRSS','0 kB').split()[0])*1024
+                except FileNotFoundError:pass
+            peak_rss=max(peak_rss,rss)
+            assert rss<=48<<30,'sum of direct pipeline process RSS exceeds 48 GiB'
+            if time.monotonic()-last_progress>10:
+                (case/'resource-progress.json').write_text(json.dumps({'elapsed_seconds':time.monotonic()-started,'pipeline_process_rss_bytes':rss,'pipeline_process_peak_rss_bytes':peak_rss}))
+                last_progress=time.monotonic()
+            if gpu.poll() is not None and not marked:
+                assert gpu.returncode==0,'sampler application failed'
+                hw.validate(case,model,workload['decode_steps'],'none',hw.sha(driver),hw.read(H/workload['id']/'reference.json'))
+                finishes=[p for p in observer.glob('process-*/finish.json') if hw.read(p)['pid']==gpu.pid and hw.read(p)['start_ticks']==gpu_birth]
+                assert len(finishes)==1
+                assert all(hw.sha(p)==sha for p,sha in pins.items())
+                hw.save(case/'producer-exit.json',{'schema':'SG_SAMPLE_PRODUCER_EXIT_V1','returncode':gpu.returncode,'pid':gpu.pid,'start_ticks':gpu_birth,'observer_finish':str(finishes[0]),'source_pins_match':True});marked=True
+                # CPU fitting needs no GPU lease. Release only after our GPU
+                # child has exited and its source/numerical identity passed.
+                lease.close();lease=None
+                hw.save(case/'gpu-lease-released.json',{'producer_pid':gpu.pid,'producer_returncode':0,'elapsed_seconds':time.monotonic()-started})
+            for c in children:assert c.poll() in (None,0),('child failed',c.pid,c.returncode)
+            time.sleep(.3)
+        assert marked
+        transport=hw.read(case/'consumer.json');profiles=hw.read(case/'profiles/receipt.json')
+        assert transport['status']=='PASS_SAMPLED_TRANSPORT_ONLY'
+        assert profiles.get('transport_qualified') and profiles.get('replay_closed')
+        assert profiles['source_population_scope']=='representative_subset' and not profiles['full_launch_population_complete']
+        assert all(hw.sha(p)==sha for p,sha in pins.items())
+        summary={'workload':workload['id'],'source_population_scope':'representative_subset','selected_records':transport['selected_records'],'sampled_kernels':len(transport['kernels']),'profiles_accepted':profiles['packed_models_accepted'],'profiles_missing':profiles['packed_models_missing'],'seconds':time.monotonic()-started,'pipeline_process_peak_rss_bytes':peak_rss,'native_fixture_bytes':profiles['raw_memory_trace_bytes'],'hardware_accuracy_accepted':False}
+        hw.save(case/'finish.json',summary)
+        return summary
+    finally:
+        for fd in [raw_read,raw_write,proj_read,proj_write]:
+            if fd is not None:os.close(fd)
+        for c in children:
+            if c.poll() is None:stop_group(c,signal.SIGTERM)
+        for c in children:
+            try:c.wait(timeout=10)
+            except subprocess.TimeoutExpired:stop_group(c,signal.SIGKILL);c.wait(timeout=10)
+        for f in logs:f.close()
+        if lease is not None:lease.close()
+try:
+    contract=hw.read(H/'contract.json')
+    shared=R/'memgen-r4-llm-shared-20260922-r2/finish.json'
+    deadline=time.monotonic()+1200
+    while not shared.exists():
+        assert time.monotonic()<deadline,'shared-profile collection wait budget';time.sleep(2)
+    assert hw.read(shared)['status']=='PASS_FOUR_LLM_SHARED_PROFILES_NOT_TRAFFIC_ACCURACY'
+    selected=[w for w in contract['workloads'] if w['id']==args.workload]
+    assert len(selected)==1
+    for workload in selected:
+        summary=run_case(workload);result['cases'].append(summary)
+        (OUT/'progress.json').write_text(json.dumps(result,indent=2));print(json.dumps(summary),flush=True)
+    result['status']='PASS_PILOT_SOURCE_DIAGNOSTIC_NOT_LLM_ACCURACY' if not any(x['profiles_missing'] for x in result['cases']) else 'PILOT_ADDRESS_RULE_REJECTIONS'
+except BaseException:result.update(status='FAIL',error=traceback.format_exc())
+finally:
+    hw.save(OUT/'finish.json',result)
+print(json.dumps(result),flush=True)
