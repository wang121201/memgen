+ header,receipt=compile_header(plan)
+ (folder/'compiled-plan.h').write_text(header)
+ result=dict(status='PASS_FROZEN_TARGETED_SPARSE_PLAN_NOT_SOURCE_ACCEPTANCE',selected_kernels=sum(bool(x['fit_ctas'] or x['holdout_ctas']) for x in plan['launches']),
+  selected_ctas=sum(len(x['fit_ctas'])+len(x['holdout_ctas']) for x in plan['launches']),all_launch_rows=len(plan['launches']),
+  plan_sha256=hashlib.sha256((folder/'pilot.json').read_bytes()).hexdigest(),audit=audit,compiler=receipt)
