index 0000000..b142f83
--- /dev/null
+++ b/research/r4_l1_filter/repair_source_plan.py
@@ -0,0 +1,158 @@
+"""Compile diagnostic sampling proposals; do not deploy them as formal sources.
+
+The native launch census and identities remain intact, including unsampled
+launches. Old sampled CTAs are development evidence, never fresh holdouts.
+The enlarged complete-grid choices only diagnose unsupported rules. The formal
+workflow remains sparse NVBit samples -> HBServe profiles -> expanded SASS ->
+memgen. Repair sparse rules before adopting any proposal. No GPU runs here.
+"""
+import argparse, collections, copy, hashlib, json, math, pathlib, sys
+
+P = pathlib.Path
+R = P('/home/xmu/nvidiagds/codex-runs')
+SOURCE = R / 'memgen-llm-source-p128d2d4-20260922-r3'
+UPSTREAM = R / 'l2-sglang-full-qualified-20260919-01a08d87-r1'
+PREVIOUS = R / 'memgen-r4-source-plan-20260922-r2'
+
+
+def sha(p):
+    return hashlib.sha256(P(p).read_bytes()).hexdigest()
+
+
+def save(p, value):
+    with P(p).open('x') as f:
+        json.dump(value, f, indent=2)
+        f.write('\n')
+
+
+def revised(row):
+    gx, gy, gz = row['grid']
+    n = gx * gy * gz
+    name = row['function_name']
+    old = set(row['fit_ctas'] + row['holdout_ctas'])
+    # Small heterogeneous grids and data-dependent gather addresses are
+    # enumerated rather than inferred from an inadequate affine witness.
+    small_gemm = n <= 64 and (
+        'cutlass::Kernel2' in name or
+        name == 'ampere_bf16_s16816gemm_bf16_64x64_ldg8_f2f_stages_64x5_tn')
+    singleton_rope_rows = 'BatchQKApplyRotary' in name and gx == 1
+    observed_irregular_copy = 'direct_copy_kernel_cuda' in name and n <= 8192
+    variable_merge = 'PersistentVariableLengthMergeStatesKernel' in name and n <= 8192
+    if n <= 32 or small_gemm or singleton_rope_rows or observed_irregular_copy or variable_merge or ('indexSelectLargeIndex' in name and n <= 4096):
+        return list(range(n)), [], 'complete_grid_no_extrapolation'
+
+    train = set()
+    if 'BatchQKApplyRotary' in name and gy > 1 and gz == 1:
+        # Existing categorical-y schema needs both train and held-out data
+        # for every y category. This does not assert within-row homogeneity.
+        for y in range(gy):
+            train.update(y * gx + x for x in {0, 1, gx // 2, gx - 1} if x < gx)
+        categories = [[y * gx + x for x in range(gx)] for y in range(gy)]
+        wanted = 2
+        strategy = 'categorical_y_stratified'
+    else:
+        stride = 1
+        for dim in row['grid']:
+            train.update(k * stride for k in {0, 1, 2, 4, 8, dim // 4, dim // 2, dim - 1} if k < dim)
+            stride *= dim
+        # Cross-axis witnesses prevent a purely local affine fit from being
+        # admitted before mid/late x positions have constrained the model.
+        for y, z in {(gy - 1, 0), (0, gz - 1), (gy - 1, gz - 1)}:
+            train.update(x + gx * (y + gy * z) for x in {gx // 2, gx - 1})
+        categories = [list(range(n))]
+        wanted = 4
+        strategy = 'distributed_coordinate_training'
+
+    hold = []
+    for category in categories:
+        remaining = [c for c in category if c not in train and c not in old]
+        # Deterministic, address-independent ordering frozen before capture.
+        remaining.sort(key=lambda c: hashlib.sha256(
+            (row['code_sha256'] + repr(row['grid']) + ':fresh-holdout-v1:' + str(c)).encode()).digest())
+        assert len(remaining) >= wanted, (name, row['grid'], 'insufficient fresh holdout')
+        hold.extend(remaining[:wanted])
+    assert len(train) >= 7 or strategy == 'categorical_y_stratified'
+    assert set(hold).isdisjoint(old | train)
+    return sorted(train), sorted(hold), strategy
+
+
+def signature(row):
+    return (row['code_sha256'], tuple(row['grid']), tuple(row['block']),
+            row['dynamic_shared_bytes'], row['phase'], row['role'])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=P, required=True)
+    args = parser.parse_args()
+    args.output.mkdir()
+    sys.path.insert(0, str(UPSTREAM / 'nvbit_sampler_r4'))
+    from compile_plan import compile_header
+    prior = next((R / 'memgen-r4-llm-samples-20260922-r3/qwen1p5b-P128D2/observer').glob('process-*/finish.json'))
+    observed = json.loads(prior.read_text())
+    ledger = {x[0]: dict(zip(observed['sampling_flush_ledger_columns'], x))
+              for x in observed['sampling_flush_ledger']}
+    result = {'status': 'PASS_DIAGNOSTIC_PLAN_COMPILATION_ONLY', 'GPU_run': False,
+              'formal_source_plan_accepted': False,
+              'prior_observer': {'path': str(prior), 'sha256': sha(prior)},
+              'old_samples_scope': 'development_evidence', 'cases': []}
+    for original in sorted(SOURCE.glob('*/candidate-plan.json')):
+        case = args.output / original.parent.name
+        case.mkdir()
+        plan = json.loads(original.read_text())
+        prior_plan_path = PREVIOUS / original.parent.name / 'full-proposal.json'
+        prior_plan = json.loads(prior_plan_path.read_text())
+        assert len(prior_plan['launches']) == len(plan['launches'])
+        audit, strategies = [], collections.Counter()
+        pilot = copy.deepcopy(plan)
+        selected = set()
+        estimate_full = estimate_pilot = 0.0
+        estimated_max_kernel = 0.0
+        for row, pr, previous in zip(plan['launches'], pilot['launches'], prior_plan['launches']):
+            fit, hold, strategy = revised(row)
+            key = f"epoch-{row['epoch_id']}-launch-{row['epoch_launch_ordinal']}"
+            count = len(fit) + len(hold)
+            assert count <= 8192
+            audit.append(dict(key=key, strategy=strategy, old_fit=row['fit_ctas'],
+                              old_hold=row['holdout_ctas'], revised_fit=fit, revised_hold=hold))
+            row.update(fit_ctas=fit, holdout_ctas=hold)
+            strategies[strategy] += 1
+            changed = fit != previous['fit_ctas'] or hold != previous['holdout_ctas']
+            keep = changed and signature(row) not in selected
+            if keep:
+                selected.add(signature(row))
+            pr.update(fit_ctas=fit if keep else [], holdout_ctas=hold if keep else [])
+            if original.parent.name == 'qwen1p5b-P128D2':
+                old = ledger[key]
+                estimate = old['selected_records'] * count / old['planned_cta_count']
+                estimate_full += estimate
+                if keep:
+                    estimate_pilot += estimate
+                    estimated_max_kernel = max(estimated_max_kernel, estimate)
+        pilot['max_selected_kernels'] = len(selected)
+        # Budget is an estimate using old average records/CTA, not an upper
+        # bound. Hard sampler and postprocessor caps are unchanged.
+        budget = dict(full_records_estimate=estimate_full or None,
+                      pilot_records_estimate=estimate_pilot or None,
+                      pilot_max_kernel_estimate=estimated_max_kernel or None,
+                      estimate_is_hard_bound=False, max_records=16000000,
+                      max_kernel_records=1000000, max_wire_bytes=12 << 30)
+        compiled = {}
+        for kind, payload in [('full-proposal', plan), ('pilot', pilot)]:
+            payload['source_population_scope'] = 'representative_subset' if kind == 'pilot' else 'all_native_launches'
+            target = case / (kind + '.json')
+            save(target, payload)
+            header, receipt = compile_header(payload)
+            (case / (kind + '.h')).write_text(header)
+            compiled[kind] = dict(receipt, file_sha256=sha(target))
+        save(case / 'selection-audit.json', audit)
+        result['cases'].append(dict(workload=case.name, original_sha256=sha(original),
+                                   previous_plan_sha256=sha(prior_plan_path),
+                                   pilot_scope='only_changed_sampling_strategies',
+                                   compiled=compiled, strategies=dict(strategies), budget=budget))
+    save(args.output / 'receipt.json', result)
+    print(json.dumps(result))
+
+
+if __name__ == '__main__':
+    main()
