+"""All retained profiles versus their old census, plus paired exact enumeration."""
+import argparse,hashlib,json,pathlib,sys,time,copy
+P=pathlib.Path;U=P('/home/xmu/nvidiagds/codex-runs/l2-sglang-full-qualified-20260919-01a08d87-r1');sys.path.insert(0,str(U))
+import sglang_sample_to_packed as p
+from sparse_profile_adapter import install
+from profile_census import count_profile
+
+def main():
+ a=argparse.ArgumentParser();a.add_argument('--receipt',type=P,required=True);a.add_argument('--output',type=P,required=True);args=a.parse_args();args.output.mkdir()
+ receipt=json.loads(args.receipt.read_text());assert receipt['replay_closed'] and receipt['transport_qualified'];install(p)
+ profiles=[];started=time.perf_counter()
+ for row in receipt['packed_profiles']:
+  if row['status']!='PASS_PROFILE_EXACT_SAMPLES':continue
+  idx=row['profile_index']
+  with P(idx['path']).open('rb') as f:f.seek(idx['offset']);raw=f.read(idx['bytes'])
+  assert hashlib.sha256(raw).hexdigest()==idx['sha256'];profile=json.loads(raw)
+  assert count_profile(profile,p)==profile['independent_source_census'],row['source_launch_key']
+  profiles.append((row,profile))
+ all_seconds=time.perf_counter()-started
+ # Select expensive cases using previously recorded baseline timings, before
+ # measuring this implementation. The slow path still evaluates every CTA.
+ chosen=sorted(profiles,key=lambda x:x[0]['stage_timings']['census_seconds'],reverse=True)[:3];timings=[]
+ for row,profile in chosen:
+  trials=[]
+  for trial in range(3):
+   measured={}
+   for fast in ([False,True] if trial%2==0 else [True,False]):
+    start=time.perf_counter();value=count_profile(profile,p,fast=fast);elapsed=time.perf_counter()-start
+    assert value==profile['independent_source_census'];measured['fast' if fast else 'enumerated']=elapsed
+   trials.append(measured)
+  timings.append(dict(key=row['source_launch_key'],grid=profile['kernel']['grid_size'],trials=trials))
+ # Residue-sensitive and byte-crossing cases must use the exact fallback.
+ seed=copy.deepcopy(profiles[0][1]);seed.pop('structural_classes',None);seed.pop('structural_class_selector',None);seed.pop('cta_class_by_id',None)
+ first=next(e for _,q in profiles for template in p.template_by_cta(q) for e in template)
+ seed['schema']['version']=4;seed['template']=[copy.deepcopy(first)];seed['kernel']['grid_dims']=[37,1,1];seed['kernel']['grid_size']=37
+ for stride in [1,2,4,16,31,32,64,-4]:
+  seed['template'][0]['address_rules']=[dict(intercept=0x1000001,cta_x_stride=stride)]
+  assert count_profile(seed,p)==count_profile(seed,p,fast=False)
+ result=dict(status='PASS_EXACT_CENSUS_AGGREGATION',profiles=len(profiles),all_profile_fast_seconds_including_io=all_seconds,paired_cases=timings,unaligned_stride_cases=8,hardware_accuracy_accepted=False)
+ with (args.output/'result.json').open('x') as f:json.dump(result,f,indent=2)
+ print(json.dumps(result))
+if __name__=='__main__':main()
