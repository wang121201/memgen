+        command=['sudo','-S','-p','','--','/usr/bin/env',*[k+'='+v for k,v in env.items()],'/usr/bin/timeout','--kill-after=20','600',hw.NCU,'--config-file','off','--target-processes','all','--profile-from-start','off','--replay-mode','kernel','--cache-control','none','--clock-control','none','--metrics','launch__shared_mem_config_size','--export',str(case/'capture'),*app]
