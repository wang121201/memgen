@@ -0,0 +1,60 @@
+"""Private additions to the pinned HBServe fitter; no hardware parameters.
+
+The one-dimensional quotient/remainder rule uses the existing producer and
+consumer schema. Only training observations participate in model selection.
+Independent lane-exact held-out checking remains the caller's responsibility.
+"""
+from functools import lru_cache
+from math import isqrt
+
+@lru_cache(maxsize=256)
+def divisors(extent):
+    values=set()
+    for x in range(2,isqrt(extent)+1):
+        if extent%x==0:
+            values.update((x,extent//x))
+    return tuple(sorted(values))
+
+def fit_1d_quotient_remainder(points, grid_dims, label):
+    def require(ok, reason):
+        if not ok:
+            raise ValueError(label + ': ' + reason)
+    extent, gy, gz = grid_dims
+    require(gy == gz == 1 and extent > 1, 'one-dimensional grid required')
+    observed = dict(points)
+    require(len(observed) == len(points), 'duplicate training CTA')
+    require(all(type(x) is int and 0 <= x < extent for x in observed), 'training CTA outside grid')
+    require(len(observed) >= 5 and {0, 1, extent-1} <= observed.keys(),
+            'tiled 1D rule needs five training CTAs including 0, 1, and last')
+    base = observed[0]
+    candidates = []
+    # Divisors describe a geometry-constrained layout, not arbitrary change
+    # points. Exclude extent itself: its quotient coefficient is unobserved.
+    for divisor in divisors(extent):
+        remainder_stride = observed[1] - base
+        q, r = divmod(extent-1, divisor)
+        numerator = observed[extent-1] - base - remainder_stride*r
+        if numerator % q:
+            continue
+        quotient_stride = numerator // q
+        if all(base + quotient_stride*(x//divisor) + remainder_stride*(x%divisor) == addr
+               for x, addr in observed.items()):
+            candidates.append((divisor, quotient_stride, remainder_stride))
+    require(len(candidates) == 1,
+            'tiled 1D divisor is not uniquely identified by training CTAs (%d candidates)' % len(candidates))
+    divisor, quotient_stride, remainder_stride = candidates[0]
+    return dict(kind='coordinate_x_quotient_remainder_y_table_z_partition',
+                intercept=base, cta_x_divisor=divisor,
+                cta_x_quotient_stride=quotient_stride,
+                cta_x_remainder_stride=remainder_stride,
+                cta_y_offsets=[0], cta_z_stride=0,
+                scope='one_dimensional_unique_training_fit_requires_disjoint_holdout')
+
+
+def install(rules):
+    original = rules.fit_x_quotient_remainder_y_table_z_partition
+    def tiled(points, grid_dims, label):
+        if tuple(grid_dims[1:]) == (1, 1):
+            return fit_1d_quotient_remainder(points, grid_dims, label)
+        return original(points, grid_dims, label)
+    rules.fit_x_quotient_remainder_y_table_z_partition = tiled
