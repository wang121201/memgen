+"""Independent synthetic lane-address oracle through the existing C++ consumer."""
+import argparse,json,pathlib,sys,types
+P=pathlib.Path;U=P('/home/xmu/nvidiagds/codex-runs/l2-sglang-full-qualified-20260919-01a08d87-r1')
+sys.path.insert(0,str(U))
+import sglang_sample_to_packed as p
+from sparse_rule_extensions import install
+
+def main():
+ a=argparse.ArgumentParser();a.add_argument('--output',type=P,required=True);args=a.parse_args();args.output.mkdir()
+ p.frozen_gate();install(p.rules)
+ train=[0,1,2,4,7,8,9,16,32,63];hold=[3,15,31,47]
+ def record(c):
+  base=0x12000000+4096*(c//8)+64*(c%8)
+  return dict(mask=(1<<32)-1,op=ord('R'),opcode='LDG.E',mem_width=4,pc=0x100,
+              lanes=[dict(lane=i,addr=base+4*i,is_local=0) for i in range(32)])
+ samples={(c,0):[record(c)] for c in train+hold}
+ collector=types.SimpleNamespace(samples=samples,estimated_sites=[],count=len(samples))
+ begin=dict(fit_ctas=train,holdout_ctas=hold,grid=[64,1,1],block=[32,1,1],kernel_name='synthetic_1d_tiled',phase='Synthetic')
+ profile=p.fit(collector,begin)
+ # This digest is made independently from all literal lane addresses, never
+ # from the fitted rule or from C++ output; it tests all unsampled CTAs too.
+ full=p.normalize({(c,0):[record(c)] for c in range(64)})
+ profile['native_reference_digest']=p.captured_digest(full)
+ profile['source']['kind']='synthetic_exact_lane_oracle_not_hardware'
+ result=p.run_model(args.output/'cpp',profile)
+ samples[(hold[0],0)][0]['lanes'][5]['addr']+=1
+ try:p.validate_samples(profile,p.normalize(samples))
+ except AssertionError:pass
+ else:raise AssertionError('one-byte heldout lane mismatch admitted')
+ summary=dict(status='PASS_SYNTHETIC_CPP_FULL_GRID_AND_ONE_BYTE_REJECTION',ctas=64,lanes=2048,
+              source=result['source'],hardware_accuracy_accepted=False)
+ with (args.output/'result.json').open('x') as f:json.dump(summary,f,indent=2)
+ print(json.dumps({k:v for k,v in summary.items() if k!='source'}))
+
+if __name__=='__main__':main()
