+"""Exact address and underdetermination checks for the sparse 1D addition."""
+import importlib.util,json,pathlib,sys
+from sparse_rule_extensions import install,fit_1d_quotient_remainder
+
+def main():
+    path=pathlib.Path(sys.argv[1])
+    spec=importlib.util.spec_from_file_location('r15_test',path)
+    rules=importlib.util.module_from_spec(spec);spec.loader.exec_module(rules)
+    install(rules)
+    train=[0,1,2,4,7,8,9,16,32,63]
+    address=lambda x:0x12000000+4096*(x//8)+64*(x%8)
+    fitted=rules.fit_coordinate_rule([(x,address(x)) for x in train],(64,1,1),'test')
+    assert fitted['cta_x_divisor']==8
+    entry={'address_rules':[fitted]}
+    for x in range(64):
+        assert rules.predict_bases(entry,x,(64,1,1))==[address(x)]
+    rejected=0
+    for points in [list(zip([0,1,2,3,63],[0,64,128,192,4032])),
+                   [(x,address(x)) for x in train if x!=63],
+                   [(x,address(x)+(x==9)) for x in train]]:
+        try:fit_1d_quotient_remainder(points,(64,1,1),'negative')
+        except ValueError:rejected+=1
+        else:raise AssertionError('ambiguous, incomplete, or corrupt training admitted')
+    assert rejected==3
+    print(json.dumps(dict(status='PASS',all_grid_exact_addresses=64,negative_cases=rejected,hardware_accuracy_accepted=False)))
+
+if __name__=='__main__':main()
