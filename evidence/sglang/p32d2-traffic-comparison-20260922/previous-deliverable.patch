diff --git a/research/r4_l1_filter/benchmark_r4.cpp b/research/r4_l1_filter/benchmark_r4.cpp
new file mode 100644
index 0000000..4c6947e
--- /dev/null
+++ b/research/r4_l1_filter/benchmark_r4.cpp
@@ -0,0 +1,36 @@
+// Paired, bounded CPU microbenchmark. This is not LLM throughput evidence.
+#define R4L1ReadFilter OriginalR4L1ReadFilter
+#define R4Allocation OriginalR4Allocation
+#define R4ReadResult OriginalR4ReadResult
+#include BASELINE_HEADER
+#undef R4L1ReadFilter
+#undef R4Allocation
+#undef R4ReadResult
+#undef MEMGEN_R4_L1_READ_FILTER_H
+#include "../../release/source/tools/r4_l1_read_filter.h"
+#include <chrono>
+#include <iostream>
+using namespace hyfiss_request_trace;
+template<class Model,class Allocation> void run(const char* label,unsigned trial,unsigned nalloc,unsigned burst) {
+  Model model(48);std::vector<Allocation> alloc;
+  for(unsigned a=0;a<nalloc;++a)alloc.push_back({a+1,0x100000000ULL+a*0x100000ULL,0x80000});
+  uint64_t checksum=0,requests=0;auto start=std::chrono::steady_clock::now();
+  for(unsigned kernel=0;kernel<240;++kernel) {
+    model.begin_kernel(std::array<unsigned,3>{32,64,100}[kernel%3],alloc);
+    for(unsigned i=0;i<16384;++i) {
+      unsigned a=((i/burst)*37)%nalloc;
+      auto result=model.access((i/128)%48,alloc[a].base+((i*997)%8192)*32);
+      checksum+=result.outcome+result.after+result.victim_valid+(result.victim_addr>>5);++requests;
+    }
+  }
+  auto seconds=std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count();
+  std::cout<<label<<','<<trial<<','<<nalloc<<','<<burst<<','<<requests<<','<<seconds<<','<<checksum<<'\n';
+}
+int main() {
+  std::cout<<"variant,trial,allocations,burst,requests,seconds,checksum\n";
+  for(auto n:{1u,256u})for(auto burst:{1u,64u})for(unsigned trial=0;trial<5;++trial) {
+    if(trial%2)run<R4L1ReadFilter,R4Allocation>("optimized",trial,n,burst);
+    run<OriginalR4L1ReadFilter,OriginalR4Allocation>("baseline",trial,n,burst);
+    if(!(trial%2))run<R4L1ReadFilter,R4Allocation>("optimized",trial,n,burst);
+  }
+}
