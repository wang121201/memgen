+  ('copy',297,[297,1,1],[0,1,2,4,8,74,148,295,296],[15,19,23,250]),
+  ('argmax',19,[1,19,1],[0,1,2,4,8,9,17,18],[14,15]),
+  ('active',48,[48,1,1],[0,1,2,4,8,9,10,11,12,24,46,47],[6,7,30,31])]:
+  def records(c):
+   count=2
+   if name=='copy' and c==n-1:count=1
+   if name=='argmax':count=3 if c==0 else 1 if c==n-1 else 2
+   if name=='active' and c>=12:return [dict(mask=0,lanes=[])]
+   return [dict(mask=(1<<32)-1,op=ord('R'),opcode='LDG.E',mem_width=4,pc=0x100+4*j,
+     lanes=[dict(lane=i,addr=0x12000000+c*4096+j*128+i*4,is_local=0) for i in range(32)]) for j in range(count)]
+  samples={(c,0):records(c) for c in train+hold};collector=types.SimpleNamespace(samples=samples,estimated_sites=[],count=sum(map(len,samples.values())))
+  begin=dict(fit_ctas=train,holdout_ctas=hold,grid=grid,block=[32,1,1],kernel_name='synthetic_'+name,phase='Synthetic')
+  profile=p.fit(collector,begin);assert profile['schema']['version']==12
+  profile['source']['kind']='synthetic_full_lane_oracle_not_hardware'
+  full=p.normalize({(c,0):records(c) for c in range(n)});profile['native_reference_digest']=p.captured_digest(full)
+  run_profile(profile,name);profiles[name]=profile
+  summary.append(dict(name=name,ctas=n,exact_digest=True,sampled_ctas=len(samples),instructions=profile['independent_source_census']['mem_insts']))
+  changed=copy.deepcopy(samples);changed[(hold[0],0)][0]['lanes'][5]['addr']+=1
+  try:p.validate_samples(profile,p.normalize(changed))
+  except AssertionError:pass
