+    profiles=json.loads((shared/name/'shared-profiles.json').read_text())['kernels'];assert len(launches)==len(profiles)
+    subgroup=collections.defaultdict(lambda:{'kernels':0,'kernels_with_potential_l1_read':0,'static_read_opcodes':collections.Counter()})
