+"""Paired CPU timings; explicitly not end-to-end LLM speed measurements."""
+import argparse,csv,json,os,pathlib,statistics,subprocess
+P=pathlib.Path;SRC=P(__file__).resolve().parent;REPO=SRC.parents[1]
+a=argparse.ArgumentParser();a.add_argument('--output',type=P,required=True);OUT=a.parse_args().output;OUT.mkdir()
+baseline=OUT/'baseline_r4.h'
+baseline.write_bytes(subprocess.check_output(['git','show','b351a0c07922f96444728b85a7d2ccf1805e9c94:release/source/tools/r4_l1_read_filter.h'],cwd=REPO))
+argv=['g++','-std=c++17','-O3','-DBASELINE_HEADER="'+str(baseline)+'"',str(SRC/'benchmark_r4.cpp'),'-o',str(OUT/'benchmark')]
+with (OUT/'build.log').open('x') as f:subprocess.run(argv,check=True,stdout=f,stderr=subprocess.STDOUT,timeout=120)
+cpu=max(os.sched_getaffinity(0))
+with (OUT/'timings.csv').open('x') as f:subprocess.run(['taskset','-c',str(cpu),str(OUT/'benchmark')],stdout=f,check=True,timeout=180)
+rows=list(csv.DictReader((OUT/'timings.csv').open()));summary=[]
+for count in [1,256]:
+ for burst in [1,64]:
+  pairs=[]
+  for trial in range(5):
+   found={x['variant']:x for x in rows if int(x['allocations'])==count and int(x['burst'])==burst and int(x['trial'])==trial}
+   before,after=found['baseline'],found['optimized']
+   assert before['checksum']==after['checksum'] and before['requests']==after['requests']
+   pairs.append(float(before['seconds'])/float(after['seconds']))
+  summary.append(dict(allocations=count,consecutive_requests_per_allocation=burst,paired_speedups=pairs,median_speedup=statistics.median(pairs)))
+result=dict(status='PASS_CPU_MICROBENCHMARK_SAME_RESULT_CHECKSUM',pairs=20,requests_per_trial=240*16384,cpu_affinity=cpu,
+ scope='48 SMs, 240 kernels switching 32/64/100 KiB; same CPU, alternating order; not exclusive host and not LLM timing',conditions=summary)
+with (OUT/'result.json').open('x') as f:json.dump(result,f,indent=2)
+print(json.dumps(result))
