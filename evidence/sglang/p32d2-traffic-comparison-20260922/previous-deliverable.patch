+  else:
+   available=[c for c in range(n) if c not in prior|fit]
+   available.sort(key=lambda c:hashlib.sha256((row['code_sha256']+':boundary-validation-v1:'+str(c)).encode()).digest())
+   hold=sorted(available[:2 if code=='b90813cd' else 4])
