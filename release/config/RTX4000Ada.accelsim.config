# RTX4000Ada.accelsim.config
#
# Memgen legacy (-gpgpu_*) hardware profile that reproduces the cache geometry
# and DRAM address mapping of the Accel-Sim 2.0 RTX 4000 Ada configuration
# (accelsim2.0/gpu-simulator/configs/tested-cfgs/NVIDIA_RTX_4000_Ada_Generation/
# gpgpusim.config), so the functional L1/L2/DRAM traffic model uses the same
# partition/set/bank decomposition as the Accel-Sim reference.
#
# This is a traffic-geometry reference, not a hardware-accuracy claim. The
# memgen backend remains a functional cache filter (no MSHR queueing, no DRAM
# timing), so matching the address decomposition removes one source of
# read/write mismatch but does not, by itself, close the Decode write gap.
#
# Every key below is read by read_hw_params() in
# release/source/tools/hyfiss_request_trace_generator_stream_r4_semantic.cc via
# the legacy -gpgpu_* reader, and by AccelSimAddressMapping for the DRAM
# address decomposition.

# --- Topology: 48 SMs, 10 memory controllers x 2 sub-partitions = 20 L2 partitions ---
-gpgpu_num_clusters 48
-gpgpu_num_sms_per_cluster 1
# memgen's own key names carry the Accel-Sim values (10 x 2), so both the
# Python replay wrapper and the C++ reader resolve the same 20 partitions.
-gpgpu_num_memory_controllers 10
-gpgpu_num_sub_partition_per_memory_channel 2

# --- L1: 4 sets x 64 ways x 128 B = 32 KiB per SM, linear set index ---
-gpgpu_unified_l1d_size 128
-gpgpu_l1d_cache_sets 4
-gpgpu_l1d_cache_block_size 128
-gpgpu_l1d_cache_associative 64
-gpgpu_l1d_cache_set_index_function L

# --- L2: 1024 sets x 16 ways x 128 B x 20 partitions = 40 MiB, XOR set index ---
-gpgpu_l2d_size_per_sub_partition 2048
-gpgpu_l2d_cache_sets 1024
-gpgpu_l2d_cache_block_size 128
-gpgpu_l2d_cache_associative 16
-gpgpu_l2d_cache_set_index_function X

# --- DRAM address decomposition (Accel-Sim Ada mapping) ---
# dramid@8 selects the channel at bit 8; the body reproduces the
# R/B/C/S field layout from the Accel-Sim Ada gpgpusim.config.
-gpgpu_memory_partition_indexing 0
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# --- Write-path policy: L1 write-through (bypass allocation), L2 write-back ---
# Accel-Sim Ada L1 is write-through (dl1 wr=T), L2 is write-back (dl2 wr=B).
# memgen expresses L1 write-through as bypass (store not allocated in L1) and
# L2 write-back as the default dram_store_policy=writeback.
-memgen_l1_store_policy bypass
-memgen_dram_store_policy writeback
-memgen_write_sector_policy line-miss-only
