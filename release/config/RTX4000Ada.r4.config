# Memgen unified hardware schema 1. This is an EXPERIMENTAL traffic model.
# Reproduces r4-small-shared-20260922; not an Accel-Sim drop-in configuration.
# Each key is required. Unknown, duplicate, malformed or unsupported values fail.
-memgen_schema 1
-memgen_profile_id RTX4000Ada.r4-small-shared-20260922
-memgen_calibration_status experimental

# Topology. 5 x 4 is a logical decomposition, not physical controller wiring.
-memgen_num_sms 48
-memgen_warp_size 32
-memgen_memory_channels 5
-memgen_subpartitions_per_channel 4
-memgen_dram_banks 16
-memgen_partition_index_bit 8
-memgen_address_mapping fallback_quotient_v2

# L1: 128 B lines, 32 B sectors; per-kernel shared partition selects ways.
# Empirical shared KiB:ways table -> 128/112/100/66/28 KiB effective capacity.
# Allocation-relative hash uses 32-bit arithmetic; tags remain absolute.
-memgen_l1_model allocation_clock_v1
-memgen_context_model_id r4-small-shared-20260922
-memgen_l1_sets 16
-memgen_l1_line_bytes 128
-memgen_sector_bytes 32
-memgen_l1_shared_kib_to_ways 8:64,16:56,32:50,64:33,100:14
-memgen_l1_replacement CLOCK
-memgen_l1_index allocation_relative_hash2_u32
-memgen_l1_tag absolute
-memgen_l1_read_policy ldg_strong_gpu_bypass_v1
-memgen_l1_store_policy bypass
-memgen_l1_preserve_across_kernels 0
-memgen_l1_fill_latency 0

# L2: 20 x 1024 x 16 x 128 B = 40 MiB. LRU, retained across kernels.
# Dirty bytes accumulate per sector; only valid dirty sectors can write back.
# No background/terminal dirty drain; write timing remains unvalidated.
-memgen_l2_sets_per_partition 1024
-memgen_l2_ways 16
-memgen_l2_line_bytes 128
-memgen_l2_index X
-memgen_l2_replacement LRU
-memgen_l2_clean_first_k 0
-memgen_l2_data_validity known_bytes_union_v1
-memgen_write_sector_policy line-miss-only
-memgen_dram_store_policy writeback
-memgen_l2_preserve_across_kernels 1
-memgen_l2_dirty_drain 0
-memgen_l2_streaming_fill 0
-memgen_l2_fill_latency 0

# Traffic only. MSHR (miss-status holding register), queue/DRAM timing disabled.
# Placement is generated upstream and supplied in issue.config; actual arrival
# order is not measured. These timestamps are ordering coordinates, not cycles.
-memgen_mshr_model disabled
-memgen_timing_model disabled
-memgen_cta_placement round_robin
-memgen_instruction_order timestamp
-memgen_monotonic_sm 1
-memgen_issue_interval 1
-memgen_kernel_gap 5000
